NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server — Supabase Postgres
# Prefer Transaction pooler
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

REDIS_URL=redis://127.0.0.1:6379

# HMAC salt for hashing client IPs in usage rate limits
# USAGE_IP_HASH_SALT=

OPENROUTER_API_KEY=

# Set to 0 to disable the Advanced model tier
# ADVANCED_MODEL_ENABLED=0

# Example: http://USER:PASS@p.webshare.io:80
# YOUTUBE_PROXY_URL=
# Optional 2-letter exit country, e.g. us, gb
# YOUTUBE_PROXY_COUNTRY=

# Set automatically by `pnpm worker` / `pnpm worker:prod`.
# ANALYSIS_WORKER=1

# Pino level: silent | error | warn | info | debug
# LOG_LEVEL=debug
# Pretty terminal logs
# LOG_PRETTY=0

# Account → Usage shows Stripe test-card instructions
# DEMO_MODE=true

# STRIPE_SECRET_KEY=sk_test_…   
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_PRO_MONTHLY=price_…
