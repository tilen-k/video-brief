# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase Auth (Dashboard) required for guests:
# - Authentication → Providers → Anonymous Sign-Ins: ON
# - Authentication → Providers → Manual linking: ON (Google convert via linkIdentity)
# Soft email confirm can leave is_anonymous true until verify; the app treats
# "anonymous + email attached" as converting (onboarding allowed).

# Server — Supabase Postgres
# Prefer Transaction pooler (IPv4, works on Vercel + most local networks):
#   Dashboard → Project Settings → Database → Connection string →
#   Type: Transaction  ·  Mode: URI  ·  port 6543
# User must be postgres.PROJECT_REF (not just postgres).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Redis — BullMQ analysis queue + monthly usage counters.
# TCP URL only — not Upstash REST.
# Local: docker compose up redis → redis://127.0.0.1:6379
# Prod: Railway Redis **public** URL (rediss://… or redis://…) on both Vercel and the worker.
#   Vercel cannot use Railway private networking.
REDIS_URL=redis://127.0.0.1:6379

# OpenRouter. Required on the analysis worker (classify + generate).
OPENROUTER_API_KEY=

# Set to 0 to disable the Advanced model tier (Pro falls back to Basic).
# ADVANCED_MODEL_ENABLED=0

# Optional. Residential HTTP proxy for YouTube Innertube + captions (set on Railway worker).
# Use the account username only — do not put -GB-1 / session / country in the URL.
# Example: http://USER:PASS@p.webshare.io:80
# YOUTUBE_PROXY_URL=
# Optional 2-letter exit country, e.g. us or gb
# YOUTUBE_PROXY_COUNTRY=

# Set automatically by `pnpm worker` / `pnpm worker:prod`. On Railway you can also set ANALYSIS_WORKER=1.
# ANALYSIS_WORKER=1

# Pino level: silent | error | warn | info | debug. Default debug in dev, info in prod.
# LOG_LEVEL=debug
# Pretty terminal logs (default on in non-production). Set 0 for raw JSON.
# LOG_PRETTY=0

# Stripe Billing (Pro monthly). Server-only — never expose the secret key.
# Dashboard: Product "VideoBrief Pro" + $10/mo Price; enable Tax + registrations;
# Customer Portal; webhook → /api/stripe/webhook
# Local: stripe listen --forward-to localhost:3000/api/stripe/webhook
# STRIPE_SECRET_KEY=sk_test_…   # prefer restricted key (rk_) in production
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_PRO_MONTHLY=price_…
