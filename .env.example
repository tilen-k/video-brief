# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server — Supabase Postgres (Transaction pooler recommended for serverless)
# Settings → Database → Connection string → URI (port 6543, ?pgbouncer=true)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional later
# ANTHROPIC_API_KEY=
