# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server — Supabase Postgres
# Prefer Transaction pooler (IPv4, works on Vercel + most local networks):
#   Dashboard → Project Settings → Database → Connection string →
#   Type: Transaction  ·  Mode: URI  ·  port 6543
# User must be postgres.PROJECT_REF (not just postgres).
#
# Direct db.PROJECT.supabase.co:5432 is often IPv6-only and fails with
# ENETUNREACH on networks without IPv6 — avoid for local/dev unless you
# have IPv4 add-on or working IPv6.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# OpenRouter. Required for understand/classify.
OPENROUTER_API_KEY=

# Redis. Required for monthly usage counters (and the analysis queue later).
# Local: redis://127.0.0.1:6379  ·  docker compose / Upstash / etc.
REDIS_URL=

# Optional. Webshare backbone gateway for YouTube Innertube + captions (Vercel).
# Use the account username only — do not put -GB-1 / session / country in the URL.
# Example: http://USER:PASS@p.webshare.io:80
# YOUTUBE_PROXY_URL=
# Optional 2-letter exit country, e.g. us or gb
# YOUTUBE_PROXY_COUNTRY=

# Pino level: silent | error | warn | info | debug. Default debug in dev, info in prod.
# LOG_LEVEL=debug
