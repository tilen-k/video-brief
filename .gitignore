# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
.pnpm-store
*.tgz
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
# keep next-env.d.ts tracked

notes/

# Cursor hook dirty-flag (set by afterFileEdit, cleared by stop verify)
.cursor/hooks/state/

# Agent git worktrees (see .cursor/worktree-create.sh)
.worktrees/
node_modules.stale*/
